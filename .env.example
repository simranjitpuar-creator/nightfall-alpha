NIGHTFALL_ALPHA_ENV=local
NIGHTFALL_ALPHA_DATA_DIR=data
# Optional: require this admin token for persistent runs, downloads, refreshes, and other writes.
# Public simulations remain available in bounded temporary guest mode.
# Store the production value in Secret Manager; never commit the real token.
# NIGHTFALL_ALPHA_WRITE_TOKEN=replace-with-at-least-16-random-characters
# Guest limits (per Cloud Run instance; requests are keyed by client IP).
NIGHTFALL_ALPHA_GUEST_MAX_SYMBOLS=25
NIGHTFALL_ALPHA_GUEST_MAX_TRADING_DAYS=1260
NIGHTFALL_ALPHA_GUEST_BURST_LIMIT=10
NIGHTFALL_ALPHA_GUEST_BURST_WINDOW_SECONDS=600
NIGHTFALL_ALPHA_GUEST_DAILY_LIMIT=100
NIGHTFALL_ALPHA_INITIAL_CAPITAL=1000000
NIGHTFALL_ALPHA_FEES_BPS=0.5
NIGHTFALL_ALPHA_SLIPPAGE_BPS=1.0
# flat or historical (era-based commissions/spreads)
NIGHTFALL_ALPHA_COST_MODEL=flat
# Uncomment to cap deployable capital; excess equity sits in cash earning CASH_RATE.
# NIGHTFALL_ALPHA_CAPITAL_CAPACITY=250000000
NIGHTFALL_ALPHA_CASH_RATE=0.0
# Uncomment to cap each position at this fraction of the symbol's 20-day median dollar volume.
# NIGHTFALL_ALPHA_MAX_ADV_PARTICIPATION=0.05

# Free Tiingo EOD API key (https://www.tiingo.com -> Account -> API). Used by --source tiingo.
# TIINGO_API_KEY=

# Future broker wiring. Keep real credentials out of git.
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
